[Unit]
Description=Distro Event Tracker - distro bot (Podman)

[Container]
ContainerName=distro-event-tracker-distro
Image=localhost/distro-event-tracker:RELEASE_TAG
Pull=never
EnvironmentFile=%h/.config/distro-event-tracker/distro.env
Environment=ENV_FILE=/dev/null
Environment=LOG_FILE=
Environment=HEALTH_PORT=8080
Environment=REMINDER_OPT_OUT_FILE=/data/reminders_opt_out.txt
Volume=%h/.local/share/distro-event-tracker/distro:/data
User=10001
Group=10001
UserNS=keep-id:uid=10001,gid=10001
ReadOnly=true
ReadOnlyTmpfs=true
DropCapability=all
NoNewPrivileges=true
Memory=512m
PodmanArgs=--cpus=0.5
PidsLimit=256
LogDriver=journald
StopTimeout=30
HealthStartupCmd=python -m distro_event_tracker.healthcheck
HealthStartupInterval=5s
HealthStartupRetries=60
HealthStartupTimeout=3s
HealthCmd=python -m distro_event_tracker.healthcheck
HealthInterval=30s
HealthRetries=3
HealthTimeout=3s
HealthOnFailure=kill
Notify=healthy

[Service]
Restart=always
RestartSec=5
TimeoutStartSec=300

[Install]
WantedBy=default.target
